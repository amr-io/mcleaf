# Discord Webhook for notifications & emergency alerts
DISCORD_WEBHOOK_URL="{{ daemons_discord_webhook_url }}"

# Cloudflare R2 / S3 Credentials for rclone automated off-site backups
export RCLONE_CONFIG_R2_TYPE="s3"
export RCLONE_CONFIG_R2_PROVIDER="Cloudflare"
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="{{ daemons_r2_access_key_id }}"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="{{ daemons_r2_secret_access_key }}"
export RCLONE_CONFIG_R2_ENDPOINT="{{ daemons_r2_endpoint }}"
export RCLONE_CONFIG_R2_ACL="private"
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET="true"

