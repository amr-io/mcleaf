services:
  mongo:
    command: ["--replSet", "overleaf", "--wiredTigerCacheSizeGB", "0.25"]
    healthcheck:
      test: ["CMD-SHELL", "echo 'db.stats().ok' | mongosh localhost:27017/test --quiet"]
      interval: 60s
      timeout: 10s
      retries: 5
      start_period: 20s
    restart: always
  redis:
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "64mb", "--maxmemory-policy", "allkeys-lru"]
    restart: always
